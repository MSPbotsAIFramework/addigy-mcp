# Optional overrides — addigy-mcp has no required env vars.
#
# This server speaks two Addigy API generations side by side:
#
# API v2 (preferred) — a static Addigy API key, created in Addigy under
# Account -> Integrations, sent per-request via X-Addigy-Api-Key. This
# server forwards it to Addigy as the x-api-key header on every call.
#
# API v1 (legacy) — sent per-request via X-Addigy-V1-Client-Id,
# X-Addigy-V1-Client-Secret, and X-Addigy-V1-Site (this org's Addigy site
# domain, e.g. "prod.addigy.com"). All three are required together.
#
# A caller only needs to send the header set for whichever tools (v1 or v2)
# it actually calls.

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0

# Fixed Addigy API v2 base URL — override only if Addigy provides a different
# regional endpoint for your organization.
# ADDIGY_BASE_URL=https://api.addigy.com
