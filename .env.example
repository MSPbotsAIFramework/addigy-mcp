# Optional overrides — addigy-mcp has no required env vars.
# Authentication is per-request via the X-Addigy-Api-Key request header
# (a static Addigy API key, created in Addigy under Account -> Integrations).
# This server forwards it to Addigy as the x-api-key header on every call.

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0

# Fixed Addigy API base URL — override only if Addigy provides a different
# regional endpoint for your organization.
# ADDIGY_BASE_URL=https://api.addigy.com
